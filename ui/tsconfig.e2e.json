{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}